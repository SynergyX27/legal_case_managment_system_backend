NODE_ENV=development
PORT=3001
# Use the Render external URL locally; internal URL when the API runs in the same Render region.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Render uses TLS. Keep certificate verification on. For a local PostgreSQL server use disable.
DB_SSL_MODE=verify-full
# Minimum 32 random characters; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
# Exactly the public frontend origin, no trailing slash. In dev Vite proxies /api to Node.
APP_ORIGIN=http://localhost:8080
# Generate a separate 32-byte encryption key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=replace-with-64-hex-characters
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Optional: takes priority over the encrypted token saved by owner OAuth consent in Settings.
DROPBOX_REFRESH_TOKEN=
DROPBOX_REDIRECT_URI=http://localhost:8080/api/integrations/dropbox/callback
# The same root must be used for the lifetime of uploaded files.
DROPBOX_ROOT=/LegalFlow
MAX_FILE_MB=25
# Production behind exactly one trusted reverse proxy: set to 1. Direct local access: 0.
TRUST_PROXY=0
# Optional static build directory relative to backend; API can serve frontend with one public origin.
FRONTEND_DIST=../frontend/dist

# Stripe-hosted Checkout does not require a frontend publishable key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Currency is USD, matching the existing invoice screens. Never put secret keys in frontend variables.

# Automated event emails. Never commit real passwords.
SMTP_ENABLED=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=LegalFlow
EMAIL_POLL_SECONDS=10
